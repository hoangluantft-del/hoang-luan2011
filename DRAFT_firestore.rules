rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'hoangluantft@gmail.com';
    }

    function isValidWish(data) {
      return data.keys().hasAll([
          'teacherName',
          'senderName',
          'cohort',
          'category',
          'message',
          'authorUid',
          'isPublic',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'teacherName',
          'senderName',
          'cohort',
          'category',
          'message',
          'imageDataUrl',
          'authorUid',
          'isPublic',
          'createdAt'
        ])
        && data.teacherName is string && data.teacherName.size() >= 2 && data.teacherName.size() <= 100
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.cohort is string && data.cohort.size() >= 1 && data.cohort.size() <= 80
        && data.category is string && data.category in [
          'Thầy Cô Chủ Nhiệm',
          'Thầy Cô Bộ Môn',
          'Kỷ Niệm Mái Trường',
          'Cựu Học Sinh Nhắn Gửi'
        ]
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 1000
        && (!('imageDataUrl' in data) || (
          data.imageDataUrl is string
          && data.imageDataUrl.size() >= 20
          && data.imageDataUrl.size() <= 350000
          && data.imageDataUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        ))
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp;
    }

    function isValidFlowerOffering(data) {
      return data.keys().hasAll(['userId', 'senderName', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['userId', 'senderName', 'isPublic', 'createdAt'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp;
    }

    // Public tribute wishes for teachers (open guest posting without login required)
    match /wishes/{wishId} {
      allow get: if isValidId(wishId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isValidId(wishId)
        && isValidWish(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(wishId)
        && isValidWish(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(wishId);

      // Per-wish flower reactions (open guest flower toggling without login required)
      match /flowers/{userId} {
        allow get: if isValidId(wishId) && isValidId(userId) && existing().isPublic == true;
        allow list: if resource.data.isPublic == true;
        allow create: if isValidId(wishId)
          && isValidId(userId)
          && exists(/databases/$(database)/documents/wishes/$(wishId))
          && isValidFlowerOffering(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(wishId)
          && isValidId(userId)
          && (existing().userId == userId || isAdmin());
      }
    }

    // Bouquet flower offerings for teachers (open guest flower toggling without login required)
    match /bouquetFlowers/{userId} {
      allow get: if isValidId(userId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isValidId(userId)
        && isValidFlowerOffering(incoming())
        && incoming().userId == userId
        && incoming().createdAt == request.time;
      allow delete: if isValidId(userId)
        && (existing().userId == userId || isAdmin());
    }
  }
}
